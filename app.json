{
  "expo": {
    "name": "Graham",
    "slug": "graham",
    "owner": "guodini",
    "scheme": "graham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grahamwatch.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.grahamwatch.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#032411",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "defaultChannel": "watch-updates"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Graham uses a photo you choose for your profile, a post, or a message.",
          "cameraPermission": "Graham uses the camera so you can take a photo for a message.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "210a8e11-51d2-48ed-ae3d-083238d819ce"
      }
    }
  }
}
