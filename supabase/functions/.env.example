# Secrets for the import-listings edge function. Copy to .env in this directory.
# This file is gitignored; never commit real keys.

# Required. Turns a scraped page into typed listings.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o-mini, which is cheap and good enough here.
# OPENAI_MODEL=gpt-4o-mini

# Optional. With neither key set, scraping falls back to plain fetch, which
# handles static HTML only. Set one of these for JavaScript-rendered shops.
# FIRECRAWL_API_KEY=fc-...
# JINA_API_KEY=jina_...

# Optional. Forces a provider instead of picking by which key exists.
# SCRAPE_PROVIDER=fetch

# --- send-inquiry ---------------------------------------------------------

# Production mail. With this set, inquiries go out over Resend and SMTP is unused.
# RESEND_API_KEY=re_...

# Local mail. The edge runtime and Mailpit share a docker network, so this is the
# container name and its internal SMTP port — not the 54325 you use from the Mac.
SMTP_HOST=supabase_inbucket_graham-watch
SMTP_PORT=1025

# The From address. Must be a domain you verified with Resend in production.
INQUIRY_FROM=Graham <inquiries@graham.app>

# Web origin used in the unclaimed-shop footer on inquiry mail. Defaults to
# https://graham.app. Local web is usually http://localhost:8081.
# APP_ORIGIN=http://localhost:8081

# Reply-to on claim-code mail. A dealer answering that email should reach a
# person, not the mailbox that sends codes. Defaults to hello@graham.app.
# SUPPORT_EMAIL=Graham <hello@graham.app>
