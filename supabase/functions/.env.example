# Secrets for the import-listings edge function. Copy to .env in this directory.
# This file is gitignored; never commit real keys.

# Required. Turns a scraped page into typed listings.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o-mini, which is cheap and good enough here.
# OPENAI_MODEL=gpt-4o-mini

# Optional. With neither key set, scraping falls back to plain fetch, which
# handles static HTML only. Set one of these for JavaScript-rendered shops.
# FIRECRAWL_API_KEY=fc-...
# JINA_API_KEY=jina_...

# Optional. Forces a provider instead of picking by which key exists.
# SCRAPE_PROVIDER=fetch
