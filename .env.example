# Hosted project. Used when `.env.local` is absent.
# Local development does not use this file: `npm run db:start`, then `npm run env -- local`.
# Do not put the local key here. `npm run env -- hosted` refuses a local URL.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Shows the "Sign in with Google" button. Leave unset until the two variables
# below are filled in, or the button fails every time it is pressed.
EXPO_PUBLIC_GOOGLE_SIGN_IN=

# RevenueCat (iOS/Android dev client or store builds). Leave unset for web/demo.
# Test Store: one key for every platform (`test_…` from Project → API keys).
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Production: platform keys instead of (or after) the test key.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=graham_pro

# Google OAuth, read by `supabase start` for [auth.external.google].
# Create a Web application client at https://console.cloud.google.com/apis/credentials
# and give it this authorised redirect URI:  http://localhost:54321/auth/v1/callback
# See docs/AUTH.md for the full walkthrough.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Edge function secrets — set with `supabase secrets set`, never in the client.
# Scrape provider: jina | firecrawl | fetch. See docs/SCRAPING.md.
SCRAPE_PROVIDER=jina
# Optional: raises the r.jina.ai rate limit.
JINA_API_KEY=
# Only needed when SCRAPE_PROVIDER=firecrawl.
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
