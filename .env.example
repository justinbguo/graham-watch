# Client — safe to ship, these are the public anon credentials.
# Local stack: run `npm run db:start` and copy the API URL and anon key it prints.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge function secrets — set with `supabase secrets set`, never in the client.
# Scrape provider: see docs/SCRAPING.md.
SCRAPE_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
