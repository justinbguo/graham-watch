# Copy to .env.local. Both values come from `supabase status`.
#
# The anon key only. This app never holds SUPABASE_SERVICE_ROLE_KEY: that key
# bypasses row-level security on every table, and a browser is the last place it
# belongs. Operator authority comes from the `operators` table instead.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
