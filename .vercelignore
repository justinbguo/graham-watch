/*
!assets
!scripts
!src
!app.json
!metro.config.js
# Root Directory of the graham-watch-operator project. Stripped, that project
# falls back to this repo's vercel.json and runs the Expo export.
!operator
!package-lock.json
!package.json
# npm ci fails ERESOLVE without legacy-peer-deps.
!.npmrc
!tsconfig.json
!vercel.json
# The web shell and the share image. Expo reads public/index.html when it
# exports, and copies the rest of public/ into dist. Without this, the build
# gets Expo's stock shell and crawlers never see the tags.
!public
# The dealer editor and the operator form share this parse. The operator
# Vite build cannot import it from src/, because that tree extends the Expo
# tsconfig. Both deploys use this ignore list, so the folder has to be named.
!shared
