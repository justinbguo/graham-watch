{
  "name": "graham",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.14.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright": "^1.65.0",
    "supabase": "2.117.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run check:env && expo start --go",
    "android": "npm run check:env && expo start --android --go",
    "ios": "npm run check:env && expo start --ios --go",
    "web": "npm run check:env && expo start --web",
    "start:dev": "npm run check:env && expo start --dev-client",
    "postinstall": "node scripts/guard-unhandled-nav.mjs",
    "check:env": "node scripts/check-env.mjs",
    "env": "node scripts/env.mjs",
    "backend": "node scripts/env.mjs",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "nonwatch:dry-run": "node --experimental-strip-types scripts/nonwatch-dry-run.ts",
    "functions:serve": "supabase functions serve import-listings",
    "demo": "EXPO_PUBLIC_DEMO=1 expo start --go --clear",
    "demo:ios": "EXPO_PUBLIC_DEMO=1 expo start --ios --go --clear",
    "demo:web": "EXPO_PUBLIC_DEMO=1 expo start --web",
    "build:preview:android": "npx eas-cli@latest build --profile preview --platform android",
    "build:preview:ios": "npx eas-cli@latest build --profile preview --platform ios",
    "operator": "cd operator && { test -d node_modules || npm install; } && npm run dev",
    "studio": "cd studio && { test -d node_modules || pnpm install; } && pnpm dev",
    "test:rls": "GRAHAM_TARGET=local node scripts/test-rls.mjs",
    "verify:drops": "node .cursor/skills/verify-graham/control-graham.mjs verify-drops",
    "test:filters": "GRAHAM_TARGET=local node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/filter-contract.test.mjs",
    "mock:users": "node scripts/mock-users.mjs",
    "mock:signin": "node scripts/mock-signin.mjs",
    "mock:sign-in": "npm run mock:signin",
    "import": "node scripts/import.mjs",
    "sweep": "node scripts/sweep.mjs",
    "refresh": "node scripts/refresh.mjs",
    "catalogue:audit": "node scripts/catalogue-audit.mjs",
    "dealers": "node scripts/dealers.mjs",
    "dealers:local": "GRAHAM_TARGET=local node scripts/dealers.mjs",
    "snapshot": "GRAHAM_TARGET=hosted node scripts/snapshot.mjs",
    "watch-catalog:sync": "node scripts/sync-watch-catalog.mjs"
  },
  "private": true
}
