{
  "name": "graham",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "supabase": "2.117.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run check:env && expo start --go",
    "android": "npm run check:env && expo start --android --go",
    "ios": "npm run check:env && expo start --ios --go",
    "web": "npm run check:env && expo start --web",
    "start:dev": "npm run check:env && expo start --dev-client",
    "postinstall": "node scripts/guard-unhandled-nav.mjs",
    "check:env": "node scripts/check-env.mjs",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "functions:serve": "supabase functions serve import-listings",
    "demo": "EXPO_PUBLIC_DEMO=1 expo start --go --clear",
    "demo:ios": "EXPO_PUBLIC_DEMO=1 expo start --ios --go --clear",
    "demo:web": "EXPO_PUBLIC_DEMO=1 expo start --web",
    "operator": "cd operator && { test -d node_modules || npm install; } && npm run dev",
    "studio": "cd studio && pnpm dev",
    "test:rls": "node scripts/test-rls.mjs",
    "import": "node --env-file=scripts/.env.operator.local scripts/import.mjs",
    "sweep": "node --env-file=scripts/.env.operator.local scripts/sweep.mjs",
    "dealers": "node --env-file=scripts/.env.operator.local scripts/dealers.mjs",
    "dealers:local": "node scripts/dealers.mjs",
    "snapshot": "node --env-file=scripts/.env.operator.local scripts/snapshot.mjs"
  },
  "private": true
}
