{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Node's type stripper, which runs the app tests, resolves a relative
    // import only when it names the .ts file. tsc allows that extension
    // because this project typechecks with noEmit and does not rewrite paths.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // `operator` and `studio` are their own TypeScript projects. Compiled from
  // here, their path aliases and DOM types do not exist and every file fails.
  // Each has its own build, which type checks it.
  "exclude": [
    "node_modules",
    "supabase/functions",
    "operator",
    "studio",
    // Deno script. It imports the edge functions with `.ts` specifiers, and
    // tsc follows those imports even though `supabase/functions` is excluded.
    // `deno check` in the edge-functions job is what typechecks it.
    "scripts/catalogue-preview.ts",
    // Node's test runner. It imports the drop selector, which lives next to
    // the edge function. `deno check` covers that function; this file is run
    // with `node --test --experimental-strip-types`.
    "scripts/drops-select.test.ts",
    // Same runner as drops-select. The fixture guard is plain TypeScript next
    // to the edge function, and node --test strips the types itself.
    "scripts/fixture-import.test.ts",
    // node --experimental-strip-types runs it. tsc would follow the .ts import
    // into supabase/functions, which this project excludes.
    "scripts/nonwatch-dry-run.ts",
    // Node's test runner. This tsconfig has no node types, so `node:test`
    // does not resolve here. Run the file with node --experimental-strip-types.
    "src/features/filters/deckDealerScope.test.ts"
  ]
}
